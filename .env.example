# 公益平台使用独立数据库与数据卷；不要指向公司版已有数据库。
POSTGRES_DB=infinite_canvas_public
POSTGRES_USER=infinite_canvas_public
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://infinite_canvas_public:change-me-postgres-password@postgres:5432/infinite_canvas_public

REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

MINIO_ROOT_USER=infinite_canvas_public
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ACCESS_KEY=infinite_canvas_public
MINIO_SECRET_KEY=change-me-minio-password
# 默认对象存储桶名与公司项目区分。
MINIO_BUCKET=infinite-canvas-public

# 独立随机密钥，至少 32 个字符；加密模型渠道与支付配置，必须随数据库单独备份。
CHANNEL_ENCRYPTION_KEY=change-me-at-least-32-characters-long
COOKIE_NAME=infinite_canvas_public_session
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=管理员

# 本地 docker-compose.local.yml 的宿主机端口；默认 3301，避免与公司项目的 3300 冲突。
PUBLIC_WEB_PORT=3301

# 公网 HTTPS: 1Panel -> Web Nginx -> Go API，仅向宿主机回环地址绑定 3000。
PUBLIC_URL=https://canvas.example.com
CORS_ORIGIN=https://canvas.example.com
TRUST_PROXY=true
COOKIE_SECURE=true
SESSION_DAYS=7

# 以下沿用现有文件、工作进程与保留期配置。
MAX_UPLOAD_BYTES=52428800
MAX_GENERATED_BYTES=52428800
IMAGE_WORKER_CONCURRENCY=20
ALLOW_PRIVATE_IMAGE_HOSTS=false
ORPHAN_MEDIA_GRACE_DAYS=45
REQUEST_LOG_RETENTION_DAYS=30

# 签到金额、用户/IP 频控、活跃任务数与订单有效期由管理员在后台配置。
# 默认每账号 10 次/分钟、每 IP 60 次/分钟、每账号 20 个活跃任务、订单有效期 30 分钟。
# 签到默认关闭，管理员设置奖励区间并开启后生效。
