{
    "name": "infinite-canvas-public",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 3000",
        "test": "vitest run",
        "build": "tsc --noEmit && eslint src && vite build",
        "typecheck": "tsc --noEmit",
        "analyze": "ANALYZE=1 vite build",
        "lint": "eslint src",
        "start": "vite preview --host 0.0.0.0 --port 3000",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@ant-design/icons": "^6.1.1",
        "@tanstack/react-query": "^5.100.9",
        "antd": "^6.4.2",
        "axios": "^1.16.0",
        "clsx": "^2.1.1",
        "copy-to-clipboard": "^4.0.2",
        "dayjs": "^1.11.20",
        "fflate": "^0.8.3",
        "file-saver": "^2.0.5",
        "i18next": "^26.3.6",
        "localforage": "^1.10.0",
        "lucide-react": "^1.16.0",
        "motion": "^12.38.0",
        "nanoid": "^5.1.11",
        "radix-ui": "^1.4.3",
        "react": "19.3.0",
        "react-dom": "19.2.5",
        "react-i18next": "^17.0.11",
        "react-router": "^7.12.0",
        "react-router-dom": "^7.12.0",
        "shadcn": "^4.7.0",
        "streamdown": "^2.5.0",
