    "fastify": "^5.6.1",
    "file-type": "^21.0.0",
    "image-size": "^2.0.2",
    "minio": "^8.0.6",
    "pg-boss": "^10.3.2",
    "postgres": "^3.4.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.18.6",
